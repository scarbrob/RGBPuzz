{
  "name": "rgbpuzz-api",
  "version": "0.1.0",
  "description": "Azure Functions API for RGBPuzz",
  "main": "dist/api/src/index.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "start": "func start",
    "clean": "rimraf dist",
    "prestart": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext ts --report-unused-disable-directives --max-warnings 0"
  },
  "dependencies": {
    "@azure/functions": "^4.16.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "azure-functions-core-tools": "^4.12.1",
    "eslint": "^8.57.1",
    "rimraf": "^5.0.5",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
